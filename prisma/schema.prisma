generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  guest
  master
  admin
}

enum LedgerType {
  check
  manual
  registration
  birthday
  weekly_prize
  redeem
  coupon_redeem
  expire
  referral
  promo_bonus
}

enum PromoRuleKind {
  double_check_bonus
  min_check_bonus
  weekday_multiplier
  promo_code
}

enum CouponStatus {
  active
  redeemed
  expired
}

enum BonusLotCategory {
  gift
  check
}

enum CheckInMethod {
  qr
  pin
}

enum StaffActionKind {
  check
  redeem
  manual_adjust
  visit_open
  visit_extend
  visit_close
  coupon_redeem
  guest_search
  booking_table_assign
  booking_table_move
  booking_table_swap
  guest_message
}

enum FloorElementKind {
  bar
  obstacle
  wall
  decor
}

enum BookingStatus {
  pending
  confirmed
  seated
  cancelled
  completed
  no_show
}

enum QuizSessionStatus {
  draft
  live
  closed
}

model User {
  id                  String    @id @default(uuid())
  telegramId          BigInt    @unique
  telegramUsername    String?
  role                Role      @default(guest)
  firstName           String?
  lastName            String?
  birthday            DateTime? @db.Date
  phone               String?   @unique
  balance             Int       @default(0)
  qrToken             String    @unique
  broadcastOptOut     Boolean   @default(false)
  staffNote           String?
  referralCode        String?   @unique
  referredByUserId    String?
  referrer            User?     @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals           User[]    @relation("UserReferrals")
  birthdayWarnedYear  Int?
  birthdayGreetedYear Int?
  createdAt           DateTime  @default(now())
  ledger              Ledger[]  @relation("UserLedger")
  actedLedger         Ledger[]  @relation("ActorLedger")
  bonusLots           BonusLot[]
  visits              Visit[]   @relation("VisitGuest")
  openedVisits        Visit[]   @relation("VisitOpener")
  coupons             Coupon[]
  scores              GameScore[]
  awards              WeeklyAward[]
  checkIns            CheckInLog[]
  venueCodes          VenueCode[] @relation("VenueCodeCreator")
  staffActions        StaffActionLog[] @relation("StaffActor")
  guestActions        StaffActionLog[] @relation("StaffGuest")
  bookings            BookingRequest[] @relation("BookingGuest")
  handledBookings     BookingRequest[] @relation("BookingHandler")
  referralActivations ReferralActivation[] @relation("ReferralReferrer")
  referredActivation  ReferralActivation? @relation("ReferralReferee")
  gameSessionLogs     GameSessionLog[]
  quizAnswers         QuizAnswer[]
  weeklySchedules     StaffWeeklySchedule[]
}

model StaffWeeklySchedule {
  id        String @id @default(uuid())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  weekday   Int
  startHour Int
  endHour   Int

  @@unique([userId, weekday])
}

model FloorPlan {
  id                 String       @id @default(uuid())
  name               String
  width              Int          @default(100)
  height             Int          @default(100)
  backgroundImageUrl String?
  active             Boolean      @default(true)
  tables             VenueTable[]
  elements           FloorElement[]
}

model FloorElement {
  id          String           @id @default(uuid())
  floorPlan   FloorPlan        @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  floorPlanId String
  kind        FloorElementKind
  label       String           @default("")
  posX        Float            @default(0)
  posY        Float            @default(0)
  width       Float            @default(10)
  height      Float            @default(10)
  rotation    Float            @default(0)
  sort        Int              @default(0)
}

model VenueTable {
  id          String           @id @default(uuid())
  floorPlan   FloorPlan        @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  floorPlanId String
  label       String
  description String           @default("")
  highlights  Json             @default("[]")
  photoUrl    String?
  seatsMin    Int              @default(1)
  seatsMax    Int              @default(4)
  posX        Float            @default(0)
  posY        Float            @default(0)
  width       Float            @default(10)
  height      Float            @default(10)
  rotation    Float            @default(0)
  sort        Int              @default(0)
  active      Boolean          @default(true)
  bookings    BookingRequest[]
}

model ReferralActivation {
  id               String   @id @default(uuid())
  referrer         User     @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referrerId       String
  referee          User     @relation("ReferralReferee", fields: [refereeId], references: [id])
  refereeId        String   @unique
  activatedAt      DateTime
  visitId          String?
  ledgerIdReferrer String?
  ledgerIdReferee  String?
}

model PromoRule {
  id         String        @id @default(uuid())
  promo      Promo?        @relation(fields: [promoId], references: [id])
  promoId    String?
  kind       PromoRuleKind
  params     Json          @default("{}")
  active     Boolean       @default(true)
  validFrom  DateTime?
  validUntil DateTime?
  priority   Int           @default(0)
}

model Promo {
  id                  String   @id @default(uuid())
  body                String
  photos              String[]
  showInFeed          Boolean  @default(true)
  broadcastSegment    String?
  broadcastRecipients Int?
  broadcastSent       Int?
  broadcastFailed     Int?
  createdAt           DateTime @default(now())
  rules               PromoRule[]
}

model StaffActionLog {
  id        String          @id @default(uuid())
  actor     User            @relation("StaffActor", fields: [actorId], references: [id])
  actorId   String
  guest     User?           @relation("StaffGuest", fields: [guestId], references: [id])
  guestId   String?
  action    StaffActionKind
  payload   Json            @default("{}")
  createdAt DateTime        @default(now())
}

model BookingRequest {
  id               String        @id @default(uuid())
  user             User          @relation("BookingGuest", fields: [userId], references: [id])
  userId           String
  table            VenueTable?   @relation(fields: [tableId], references: [id])
  tableId          String?
  requestedFor     DateTime
  endsAt           DateTime?
  durationMinutes  Int?
  partySize        Int
  comment          String?
  status           BookingStatus @default(pending)
  handler          User?         @relation("BookingHandler", fields: [handledBy], references: [id])
  handledBy        String?
  handledAt        DateTime?
  seatedAt         DateTime?
  tableAssignedAt  DateTime?
  reminderSent     Boolean       @default(false)
  createdAt        DateTime      @default(now())

  @@index([tableId, requestedFor])
}

model Ledger {
  id          String     @id @default(uuid())
  user        User       @relation("UserLedger", fields: [userId], references: [id])
  userId      String
  type        LedgerType
  amount      Int
  actor       User?      @relation("ActorLedger", fields: [actorId], references: [id])
  actorId     String?
  comment     String?
  checkAmount Int?
  createdAt   DateTime   @default(now())
  bonusLot    BonusLot?
}

model BonusLot {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  ledger    Ledger?          @relation(fields: [ledgerId], references: [id])
  ledgerId  String?          @unique
  category  BonusLotCategory
  initial   Int
  remaining Int
  expiresAt DateTime
  createdAt DateTime         @default(now())
  warned7d  Boolean          @default(false)
  warned3d  Boolean          @default(false)
  warned1d  Boolean          @default(false)
}

model Visit {
  id        String       @id @default(uuid())
  user      User         @relation("VisitGuest", fields: [userId], references: [id])
  userId    String
  opener    User         @relation("VisitOpener", fields: [openedBy], references: [id])
  openedBy  String
  startedAt DateTime
  endsAt    DateTime
  checkIns  CheckInLog[]
}

model VenueCode {
  id         String        @id @default(uuid())
  pin        String
  token      String        @unique
  validFrom  DateTime
  validUntil DateTime
  revokedAt  DateTime?
  createdBy  String?
  creator    User?         @relation("VenueCodeCreator", fields: [createdBy], references: [id])
  createdAt  DateTime      @default(now())
  checkIns   CheckInLog[]
}

model CheckInLog {
  id          String        @id @default(uuid())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  venueCode   VenueCode     @relation(fields: [venueCodeId], references: [id])
  venueCodeId String
  visit       Visit         @relation(fields: [visitId], references: [id])
  visitId     String
  method      CheckInMethod
  createdAt   DateTime      @default(now())
}

model Setting {
  key   String @id
  value String
}

model ContentPage {
  slug   String  @id
  body   String  @default("")
  mapUrl String?
}

model MenuItem {
  id           String  @id @default(uuid())
  title        String
  description  String  @default("")
  priceRubles  Int?
  imageFileId  String?
  imageUrl     String?
  sort         Int     @default(0)
  active       Boolean @default(true)
}

model Game {
  id                  String           @id @default(uuid())
  slug                String           @unique
  title               String
  active              Boolean          @default(true)
  maxScorePerSession  Int
  weeks               GameWeek[]
  sessionLogs         GameSessionLog[]
}

model GameWeek {
  id        String      @id @default(uuid())
  game      Game        @relation(fields: [gameId], references: [id])
  gameId    String
  weekStart DateTime
  closedAt  DateTime?
  scores    GameScore[]
  coupons   Coupon[]
  @@unique([gameId, weekStart])
}

model GameScore {
  week      GameWeek @relation(fields: [weekId], references: [id])
  weekId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  points    Int      @default(0)
  updatedAt DateTime
  @@id([weekId, userId])
}

model Coupon {
  id         String       @id @default(uuid())
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  title      String
  week       GameWeek?    @relation(fields: [weekId], references: [id])
  weekId     String?
  status     CouponStatus @default(active)
  expiresAt  DateTime
  redeemedBy String?
  redeemedAt DateTime?
}

model WeeklyAward {
  weekStart DateTime
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  place     Int
  @@id([weekStart, userId])
}

model GameSessionLog {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  game         Game     @relation(fields: [gameId], references: [id])
  gameId       String
  slug         String
  points       Int
  startedAt    DateTime
  endedAt      DateTime
  accepted     Boolean
  rejectReason String?
  createdAt    DateTime @default(now())

  @@index([userId, gameId, createdAt])
  @@index([accepted, createdAt])
}

model Quiz {
  id        String         @id @default(uuid())
  title     String
  active    Boolean        @default(true)
  showInHub Boolean        @default(false)
  questions QuizQuestion[]
  sessions  QuizSession[]
}

model QuizQuestion {
  id           String       @id @default(uuid())
  quiz         Quiz         @relation(fields: [quizId], references: [id])
  quizId       String
  sort         Int
  text         String
  imageUrl     String?
  options      Json
  correctIndex Int
  answers      QuizAnswer[]
}

model QuizSession {
  id        String            @id @default(uuid())
  quiz      Quiz              @relation(fields: [quizId], references: [id])
  quizId    String
  startedAt DateTime
  endsAt    DateTime
  status    QuizSessionStatus @default(draft)
  answers   QuizAnswer[]
}

model QuizAnswer {
  id          String       @id @default(uuid())
  session     QuizSession  @relation(fields: [sessionId], references: [id])
  sessionId   String
  question    QuizQuestion @relation(fields: [questionId], references: [id])
  questionId  String
  user        User         @relation(fields: [userId], references: [id])
  userId      String
  optionIndex Int
  elapsedMs   Int
  points      Int
  createdAt   DateTime     @default(now())

  @@unique([sessionId, questionId, userId])
}
