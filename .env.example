# Токен Telegram от @BotFather. Пусто — сайт и админка работают, бот не стартует.
TELEGRAM_BOT_TOKEN=
# Старое имя, если TELEGRAM_BOT_TOKEN пуст.
BOT_TOKEN=
# Username бота без @, для ссылки t.me и рефералки.
TELEGRAM_BOT_USERNAME=
# Telegram id администраторов через запятую. Сюда приходят новые и отменённые записи.
# Первый id — владелец по умолчанию. Команда /admin в боте доступна этим id.
# Своё значение подставляется вместо примера, список не зашит в код.
TELEGRAM_ADMIN_ID=500459806
# Секрет заголовка webhook. Пусто — считается из токена.
WEBHOOK_SECRET=
# polling — не ставить webhook, забирать апдейты с сервера.
# Нужно, если хостер не принимает входящие с api.telegram.org. Пусто — webhook на HTTPS.
TELEGRAM_TRANSPORT=
# Прокси для исходящих запросов к api.telegram.org. Пусто — напрямую.
# socks5h://логин:пароль@хост:порт или http://хост:порт
TELEGRAM_PROXY=

# Токен бота MAX (платформа MAX для бизнеса / @MasterBot). Пусто — бот MAX не стартует.
MAX_BOT_TOKEN=
# Публичная ссылка на бота, например https://max.ru/имя_бота
MAX_BOT_URL=
# Числовой user id администратора в MAX для уведомлений о записях.
MAX_ADMIN_USER_ID=

# Вход в /admin
ADMIN_LOGIN=admin
ADMIN_PASSWORD=daddyson-demo
ADMIN_SESSION_SECRET=change-me-please

# true — кнопка «Записаться» на сайте открывает демо-карту без мессенджера.
ALLOW_DEMO_GUEST=true

# Часовой пояс заведения. Бийск — Asia/Barnaul (UTC+7).
VENUE_TIMEZONE=Asia/Barnaul

PUBLIC_URL=http://localhost:3000
CADDY_DOMAIN=localhost
PORT=3000

POSTGRES_USER=daddyson
POSTGRES_PASSWORD=daddyson
POSTGRES_DB=daddyson
DATABASE_URL=postgresql://daddyson:daddyson@postgres:5432/daddyson

# Необязательно. Фото не нужны для демо барбершопа.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=menu

# Продакшен: docker compose -f docker-compose.prod.yml up -d --build
# APP_ENV=production включает отказ старта при демо-пароле и пустых секретах.
# NODE_ENV в образе всегда production и сам по себе этот режим не включает.
# APP_ENV=production
# Чат тревог сторожа. Пусто в окружении — тот же id, что пример владельца.
DEV_ALERT_CHAT_ID=500459806
# OPERATOR_LEGAL_NAME=
# OPERATOR_INN=
# OPERATOR_ADDRESS=
# POLICY_VERSION=2026-09-29
# BACKUP_HOUR=3
# Копия дампов в S3-совместимое хранилище (reg.ru, Yandex Object Storage). Пустой бакет — только локальный диск.
# BACKUP_S3_ENDPOINT=https://s3.yandexcloud.net
# BACKUP_S3_REGION=ru-central1
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=daddyson
