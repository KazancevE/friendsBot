BOT_TOKEN=
TELEGRAM_ADMIN_ID=
PUBLIC_URL=https://bot.example.com
CADDY_DOMAIN=bot.example.com
PORT=3000

POSTGRES_USER=friends
POSTGRES_PASSWORD=
POSTGRES_DB=friends

# Docker Compose: host postgres — имя сервиса. Локальный npm: замените на localhost.
DATABASE_URL=postgresql://friends:CHANGE_ME@postgres:5432/friends

# Yandex Object Storage (S3). Если S3_BUCKET не задан — файлы меню пишутся локально в uploads/menu/.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=menu
